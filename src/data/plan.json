"steps": [
{
"n": "1",
"method": "Understand the concept",
"what": "Know the data structure/pattern before coding."
},
{
"n": "2",
"method": "Read the problem",
"what": "Identify input, output, constraints, and a small example."
},
{
"n": "3",
"method": "Think on paper",
"what": "Describe a brute-force solution in plain language."
},
{
"n": "4",
"method": "Find the pattern",
"what": "Ask whether hashing, two pointers, sliding window, binary search, etc. applies."
},
{
"n": "5",
"method": "Code yourself",
"what": "Implement in C without copying."
},
{
"n": "6",
"method": "If stuck",
"what": "Try about 20 minutes, then use a hint/solution; close it and re-code yourself."
},
{
"n": "7",
"method": "Re-solve",
"what": "Re-solve after 2–3 days and again the following week."
},
{
"n": "8",
"method": "Record five things",
"what": "Problem, Pattern, Brute force, Optimized idea, My mistake."
}
]
